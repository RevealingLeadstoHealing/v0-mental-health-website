# ============================================================
# RLTH EHR — Environment Variable Reference
# Copy this file to .env.local for local development.
# Set all variables in Vercel project settings for production.
# Never commit .env.local or real secret values.
# ============================================================

# ---- AWS Region ----
# The AWS region where all EHR infrastructure is deployed.
EHR_AWS_REGION=us-east-2

# ---- Cognito Authentication ----
# Found in CloudFormation stack outputs: CognitoUserPoolId, CognitoUserPoolClientId
EHR_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
EHR_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- DynamoDB Tables ----
# Found in CloudFormation stack outputs: ClinicalRecordsTableName, AuditEventsTableName, DocumentMetadataTableName
EHR_RECORDS_TABLE=rlth-prod-clinical-records
EHR_AUDIT_TABLE=rlth-prod-audit-events
EHR_DOCUMENTS_TABLE=rlth-prod-document-metadata

# ---- S3 Document Storage ----
# Found in CloudFormation stack output: DocumentsBucketName
EHR_DOCUMENTS_BUCKET=rlth-prod-ehr-documents-<account-id>

# ---- KMS Encryption Key ----
# Found in CloudFormation stack output: KmsKeyArn
# Format: arn:aws:kms:<region>:<account-id>:key/<key-id>
EHR_KMS_KEY_ARN=arn:aws:kms:us-east-2:XXXXXXXXXXXX:key/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ---- CloudTrail ----
# Found in CloudFormation stack output: CloudTrailName
EHR_CLOUDTRAIL_NAME=rlth-prod-ehr-management-events

# ---- AWS Runtime Credentials (Vercel server-side only) ----
# For local dev: use your AWS CLI credentials (aws configure) — the SDK picks them up automatically.
# For Vercel production: set these as encrypted environment variables (not exposed to the browser).
# Alternatively, configure Vercel OIDC and use AWS_ROLE_ARN instead of static keys.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>   # preferred over static keys

# ---- SES Email (required for Cognito password reset + invite emails) ----
# Verified SES identity ARN — set after verifying your domain in SES and exiting sandbox mode.
# Format: arn:aws:ses:<region>:<account-id>:identity/<domain>
EHR_SES_FROM_ADDRESS=no-reply@revealing-leads-to-healing-wellness-services.org
EHR_SES_IDENTITY_ARN=arn:aws:ses:us-east-2:XXXXXXXXXXXX:identity/revealing-leads-to-healing-wellness-services.org

# ---- Demo Mode (must be false in production) ----
NEXT_PUBLIC_RLTH_EHR_DEMO_ENABLED=false
