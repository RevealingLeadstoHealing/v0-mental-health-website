# RLTH EHR environment variables
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle at build
# time. Changing one in a deployment dashboard has no effect until the project is
# rebuilt -- promoting or rolling back to an existing deployment reuses the value
# that was baked in when that deployment was built.
#
# Every value is trimmed before use, but avoid trailing spaces anyway: they are
# invisible in most dashboard UIs and have broken this build before.


# --- Demo mode -------------------------------------------------------------
# Controls the /ehr lock screen. Only the exact value "true" (case-insensitive,
# whitespace trimmed) opens the EHR. Demo mode stores data in browser local
# storage and enables self-registration, so it is for non-PHI testing only.
NEXT_PUBLIC_RLTH_EHR_DEMO_ENABLED=false


# --- Region ----------------------------------------------------------------
# Must be region-shaped (for example us-east-2) or it is ignored and the
# us-east-2 default is used. Note that the serverless runtime injects AWS_REGION
# with the region the function runs in, which is not necessarily the region the
# Cognito user pool lives in, so the explicit values below take priority.
EHR_AWS_REGION=us-east-2
NEXT_PUBLIC_AWS_REGION=us-east-2


# --- Cognito ---------------------------------------------------------------
# Server-side token verification reads the EHR_ variables. The NEXT_PUBLIC_
# variables are for the browser only; setting those alone does not affect how the
# API routes validate tokens.
EHR_COGNITO_USER_POOL_ID=us-east-2_kSd3RAPsl
EHR_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_kSd3RAPsl
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# The app client id must match the "aud" claim of tokens the pool issues, or every
# API call fails with "Token was not issued for this EHR application" even though
# login itself succeeds. Confirm it in Cognito under
# User pools > App integration > App clients before overriding the default.


# --- AWS runtime credentials (server only, never commit real values) --------
# Without these the app still runs, and /api/ehr/health reports
# "missing-aws-runtime-credentials". They are only needed once records and
# documents are read from or written to AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# --- Optional resource overrides -------------------------------------------
# All default to the provisioned production resources; set only to point at
# different infrastructure.
# EHR_RECORDS_TABLE=rlth-prod-clinical-records
# EHR_AUDIT_TABLE=rlth-prod-audit-events
# EHR_DOCUMENTS_TABLE=rlth-prod-document-metadata
# EHR_DOCUMENTS_BUCKET=rlth-prod-ehr-documents-597936860711
# EHR_CLOUDTRAIL_NAME=rlth-prod-ehr-management-events
# EHR_KMS_KEY_ARN=

# Removed from this file because no code reads them, and their presence here
# suggested the app was configurable in ways it was not:
#   NEXT_PUBLIC_RLTH_EHR_BACKEND, RLTH_EHR_API_BASE_URL,
#   RLTH_EHR_DOCUMENT_BUCKET, RLTH_EHR_KMS_KEY_ID
