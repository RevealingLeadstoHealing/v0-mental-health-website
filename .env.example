# ============================================================
# RLTH EHR — Environment Variable Reference
# Copy this file to .env.local for local development.
# Set all variables in Vercel project settings for production.
# Never commit .env.local or real secret values.
# ============================================================

# ---- AWS Region ----
# The AWS region where all EHR infrastructure is deployed.
EHR_AWS_REGION=us-east-2

# ---- Cognito Authentication ----
# Found in CloudFormation stack outputs: CognitoUserPoolId, CognitoUserPoolClientId
EHR_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
EHR_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- DynamoDB Tables ----
# Found in CloudFormation stack outputs: ClinicalRecordsTableName, AuditEventsTableName, DocumentMetadataTableName
EHR_RECORDS_TABLE=rlth-prod-clinical-records
EHR_AUDIT_TABLE=rlth-prod-audit-events
EHR_DOCUMENTS_TABLE=rlth-prod-document-metadata

# ---- S3 Document Storage ----
# Found in CloudFormation stack output: DocumentsBucketName
EHR_DOCUMENTS_BUCKET=rlth-prod-ehr-documents-<account-id>

# ---- KMS Encryption Key ----
# Found in CloudFormation stack output: KmsKeyArn
# Format: arn:aws:kms:<region>:<account-id>:key/<key-id>
EHR_KMS_KEY_ARN=arn:aws:kms:us-east-2:XXXXXXXXXXXX:key/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ---- CloudTrail ----
# Found in CloudFormation stack output: CloudTrailName
EHR_CLOUDTRAIL_NAME=rlth-prod-ehr-management-events

# ---- AWS Runtime Credentials (Vercel server-side only) ----
# For local dev: use your AWS CLI credentials (aws configure) — the SDK picks them up automatically.
# For Vercel production: set these as encrypted environment variables (not exposed to the browser).
# Alternatively, configure Vercel OIDC and use AWS_ROLE_ARN instead of static keys.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>   # preferred over static keys

# ---- SES Email (patient invitation + password reset emails) ----
# Primary practice sender: connect@rlth.org (rlth.org domain verified in SES, us-east-1).
# Requires SES production access (out of sandbox) before real patients receive email.
EHR_SES_FROM_ADDRESS=connect@rlth.org
EHR_SES_IDENTITY_ARN=arn:aws:ses:us-east-1:597936860711:identity/rlth.org

# ---- Cloudflare Turnstile (public Contact form anti-spam) ----
# Added 2026-11-26 for AWS SES Case 179496551900783. Create the keys in
# the Cloudflare dashboard (Turnstile > Add site) and set them in AWS
# Amplify / your hosting environment variables — never commit real keys.
# Both are required: submissions are rejected if verification is unavailable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public (shown in the page HTML).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only in Amplify or local development. Never expose or commit this value
# to a NEXT_PUBLIC_ variable.
TURNSTILE_SECRET_KEY=

# ---- Demo Mode (must be false in production) ----
NEXT_PUBLIC_RLTH_EHR_DEMO_ENABLED=false

# ---- Spruce webhook pickup (incoming fax + call/voicemail) ----
# SPRUCE_API_TOKEN: the "Live Secret" from Spruce Settings -> Integrations &
# API (not the Access ID, which starts with "aid_"). Used only as a fallback
# to re-fetch a conversationItem if a webhook event arrives without a usable
# signedUrl.
# SPRUCE_WEBHOOK_SECRET: issued by Spruce when https://<domain>/api/spruce/webhook
# is registered as a webhook destination endpoint in Spruce. Required —
# requests without a valid signature are rejected.
SPRUCE_API_TOKEN=
SPRUCE_WEBHOOK_SECRET=
