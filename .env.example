# RLTH EHR
# Legacy demo flag remains disabled in AWS production.
NEXT_PUBLIC_RLTH_EHR_DEMO_ENABLED=false

# AWS production configuration — Northern Virginia (us-east-1).
# Resource identifiers are intentionally supplied by the deployed AWS environment.
# Do not commit credentials or secrets.
NEXT_PUBLIC_RLTH_EHR_BACKEND=aws
EHR_AWS_REGION=us-east-1
NEXT_PUBLIC_AWS_REGION=us-east-1
EHR_COGNITO_USER_POOL_ID=
EHR_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
EHR_RECORDS_TABLE=rlth-prod-clinical-records
EHR_AUDIT_TABLE=rlth-prod-audit-events
EHR_DOCUMENTS_TABLE=rlth-prod-document-metadata
EHR_DOCUMENTS_BUCKET=rlth-prod-ehr-documents-597936860711
EHR_KMS_KEY_ARN=
RLTH_EHR_API_BASE_URL=

# PHI entry remains disabled unless the deployed AWS security/compliance
# controls and environment configuration have been verified.
EHR_PHI_ENTRY_ALLOWED=false
