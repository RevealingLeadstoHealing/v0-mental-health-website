# RLTH EHR
# Legacy demo flag remains disabled in AWS production.
NEXT_PUBLIC_RLTH_EHR_DEMO_ENABLED=false

# AWS production configuration. Do not commit secrets.
NEXT_PUBLIC_RLTH_EHR_BACKEND=aws
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
RLTH_EHR_API_BASE_URL=
RLTH_EHR_DOCUMENT_BUCKET=
RLTH_EHR_KMS_KEY_ID=

# Set to true only after the Ohio security stack, backup verification, BAAs,
# access procedures, and incident/retention policies are confirmed.
EHR_PHI_ENTRY_ALLOWED=false
